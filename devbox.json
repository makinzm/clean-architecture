{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "gcc@latest",
    "git@latest",
    "openssl@latest",
    "pkg-config@latest",
    "rustup@latest",
    "jq@latest",
    "sea-orm-cli@latest",
    "uv@latest",
    "volta@latest",
    "lefthook@latest"
  ],
  "shell": {
    "init_hook": [
      "OPENSSL_DEV=$(ls -d /nix/store/*-openssl-*-dev 2>/dev/null | sort -rV | head -1)",
      "if [ -n \"$OPENSSL_DEV\" ]; then",
      "    OPENSSL_PREFIX=$(grep '^prefix=' \"$OPENSSL_DEV/lib/pkgconfig/openssl.pc\" | cut -d= -f2)",
      "    export OPENSSL_DIR=$OPENSSL_PREFIX",
      "    export OPENSSL_LIB_DIR=$OPENSSL_PREFIX/lib",
      "    export OPENSSL_INCLUDE_DIR=$OPENSSL_DEV/include",
      "    export PKG_CONFIG_PATH=$OPENSSL_DEV/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}",
      "    export CPATH=$OPENSSL_INCLUDE_DIR${CPATH:+:$CPATH}",
      "    export LIBRARY_PATH=$OPENSSL_LIB_DIR${LIBRARY_PATH:+:$LIBRARY_PATH}",
      "fi"
    ]
  }
}